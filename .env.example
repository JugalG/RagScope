# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=

# Models
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-4.1-mini
CHEAP_MODEL=gpt-4.1-nano
# Optional: second model tried automatically if the answer model call fails
FALLBACK_MODEL=

# Gateway: OpenAI directly (default), or e.g. http://localhost:4000 for a LiteLLM proxy
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Chunking (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
SEARCH_MODE=hybrid
CANDIDATES=10
RRF_K=60
TOP_K=4
# Untuned starting value: check the similarity numbers printed in the terminal and adjust
MIN_SIMILARITY=0.25

# flashrank | llm | none
RERANKER=flashrank

# Chat memory
HISTORY_MAX_TOKENS=1200
HISTORY_KEEP_LAST=4

# Print every pipeline step in the terminal
VERBOSE=true

# Next phase (observability): uncomment to send traces of every LangChain call to LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=simple-rag
